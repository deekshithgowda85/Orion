# ───────────── Clerk (https://dashboard.clerk.com → your app → API Keys) ─────────────
# Publishable key is PUBLIC by design (shipped to the browser). The secret key is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Clerk routing (must match the pages in app/(auth))
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ───────────── BFF gateway (Layer 4) ─────────────
# Server-side only. Next.js proxies /api/* to this URL; the browser never sees it.
BFF_URL=http://localhost:3001

# ───────────── Demo mode (OPTIONAL, dev only) ─────────────
# true = fake /api/research/* data + no Clerk, so the UI runs with no backend and no keys.
# Ignored in production builds. Easier: `npm run dev:mock`.
# NEXT_PUBLIC_MOCK_MODE=true
