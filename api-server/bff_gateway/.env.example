# ---- REQUIRED --------------------------------------------------------------
# Where the FastAPI agent service listens (docker compose: http://agent_service:8000)
FASTAPI_BASE_URL=http://localhost:8000
# Clerk dashboard -> Configure -> API Keys
CLERK_SECRET_KEY=REPLACE_ME_sk_...
CLERK_PUBLISHABLE_KEY=REPLACE_ME_pk_...
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed to call the gateway (your frontend)
ALLOWED_ORIGINS=http://localhost:3000
# Same Neon connection string as the agent service (tenant lookup + /api/health)
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---- OPTIONAL ---------------------------------------------------------------
PORT=3001
