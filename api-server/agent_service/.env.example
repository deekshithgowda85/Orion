# ---- REQUIRED --------------------------------------------------------------
# Neon dashboard -> your project -> Connection Details -> copy the connection string
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Clerk dashboard -> Configure -> API Keys -> "Show JWT public key" -> JWKS URL
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json

# ---- STRONGLY RECOMMENDED ---------------------------------------------------
# The "Frontend API URL" of your Clerk instance (enforces the token issuer)
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
# Layer 1: where Temporal runs (docker compose service name is usually temporal:7233)
TEMPORAL_HOST=localhost:7233
REDIS_URL=redis://localhost:6379/0

# ---- OPTIONAL (defaults shown) ---------------------------------------------
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=market-research
TEMPORAL_WORKFLOW_NAME=MarketResearchWorkflow
BFF_ORIGIN=http://localhost:3001
# Used when a submit request omits "quarter" (e.g. 2025Q3). Leave empty to pass null to Layer 3.
DEFAULT_QUARTER=
# Shared secret protecting POST /internal/schedules/run-due. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
# Only if you want Inngest notified about schedule changes (Inngest dashboard -> Manage -> Event Keys)
INNGEST_EVENT_KEY=
# Not used for JWT verification (JWKS is); kept for future Clerk API calls
CLERK_SECRET_KEY=
LOG_LEVEL=INFO
