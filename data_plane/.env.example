# ---- Layer 3 additions ----
POLYGON_API_KEY=
FIRECRAWL_API_KEY=            # optional: without it (or when quota is hit) the httpx+BeautifulSoup fallback is used
E2B_API_KEY=
LLAMA_CLOUD_API_KEY=          # optional: without it filings are parsed with the local heuristic parser
SEC_EDGAR_USER_AGENT="YourName yourname@example.com"

# ---- Infra required by the stack (not in the original list, but needed to run) ----
REDIS_URL=redis://localhost:6379/0
NEON_DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require
OPENAI_API_KEY=               # embeddings for vector(1536) -> text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small
LOG_LEVEL=INFO
