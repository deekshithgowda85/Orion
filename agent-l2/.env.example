# ---- Temporal ----
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# ---- Inngest ----
# Leave keys empty when using the local Inngest dev server (INNGEST_DEV=1).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# ---- Data stores ----
NEON_DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379/0

# ---- Daily scan (portfolio.daily-scan cron) ----
DAILY_SCAN_TICKERS=AAPL,MSFT,NVDA
DAILY_SCAN_TENANT_ID=default-tenant

# ---- Docker Compose only (Temporal's own persistence, NOT Neon) ----
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_PORT=5432

# ---- Layer 2: Groq (Llama) ----
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL_LARGE=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MAX_CONCURRENCY=4
MAX_RAW_CHARS=20000
# Used only when NEON_DATABASE_URL is empty
AUDIT_LOCAL_DIR=traces
